# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* vão para o bundle do app:
# NUNCA coloque segredos aqui.
#
# URL da API (backend em Docker na porta 8000):
#   - celular físico (Expo Go/dev build): IP da sua máquina na rede local, ex. http://192.168.0.10:8000
#   - emulador Android:                   http://10.0.2.2:8000
#   - simulador iOS / web:                http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
