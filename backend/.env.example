# Copie para .env (opcional em dev: o docker-compose.yml já tem defaults).
# Em produção é obrigatório: docker compose -f docker-compose.prod.yml --env-file backend/.env ...
APP_ENV=development

POSTGRES_USER=burnless
POSTGRES_PASSWORD=burnless
POSTGRES_DB=burnless

# Dentro do Docker o host do banco é o nome do serviço: "db".
DATABASE_URL=postgresql+asyncpg://burnless:burnless@db:5432/burnless
